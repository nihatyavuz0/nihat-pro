# ============================================================================
# NİHAT PRO — Sunucu Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı ".env" adıyla kopyalayıp kendi gizli değerlerinizi girin.
# DİKKAT: Gerçek şifre, özet (hash) veya API anahtarlarını ASLA Git'e eklemeyin!
# Tarayıcıya açık PUBLIC_ / NEXT_PUBLIC_ önekli değişken KULLANMAYIN.
# ============================================================================

# 1. Oturum ve Sunucu Kasası Şifreleme Sırları (En az 64 hex karakter / 32 bayt rastgele değer)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIHAT_SESSION_SECRET=
NIHAT_VAULT_KEY=

# 2. Yönetici Kimlik Bilgileri ( Açık metin şifre KABUL EDİLMEZ — yalnızca bcrypt $2a$/$2b$ cost>=12 özeti )
# Bcrypt özeti üretmek için: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "GucluSifreniz123!"
NIHAT_ADMIN_USER=
NIHAT_ADMIN_PASSWORD_HASH=

# 3. Çoklu Kullanıcı & Rol Tanımları (İsteğe bağlı JSON dizisi: role = "admin" | "user")
# Örnek: [{"username":"editor1","role":"user","passwordHash":"$2a$12$..."}]
NIHAT_USERS_JSON=

# 4. İzin Verilen Kaynak Adresleri (CORS & Same-Origin — virgülle ayrılmış tam origin listesi)
NIHAT_ALLOWED_ORIGINS=https://nihat-pro.vercel.app

# 5. Güvenlik Uyarı Webhook Adresi (İsteğe bağlı — hesap kilitleme ve saldırı uyarıları için HTTPS URL)
NIHAT_SECURITY_WEBHOOK_URL=

# 6. Üçüncü Parti Servis API Anahtarları (Yalnızca sunucuda okunur, tarayıcıya asla gönderilmez)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PAGESPEED_API_KEY=

GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MANAGER_ID=
GOOGLE_ADS_DEV_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=

GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_ACCESS_TOKEN=
GOOGLE_MERCHANT_FEED_URL=

META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_PIXEL_ID=
META_ADS_PAGE_ID=
